{
    "main": "bin/packwright",
    "output": "build/packwright",
    "chmod": "0755",
    "compression": "GZ",
    "directories": [
        "src",
        "config"
    ],
    "files": [
        "var/cache/PackwrightContainer.php"
    ],
    "finder": [
        {
            "name": "*.php",
            "exclude": ["Tests", "tests", "test", "Fixtures", "fixtures", "docs", "doc", "examples"],
            "in": "vendor"
        },
        {
            "in": "vendor/symfony/console/Resources"
        }
    ]
}
