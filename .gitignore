# Dependencies
/vendor/

# Build output
/build/
*.phar

# Runtime cache
/var/

# PHPUnit cache
/.phpunit.result.cache
/.phpunit.cache/

# php-cs-fixer cache
/.php-cs-fixer.cache

# PHPStan cache
/.cache/phpstan/

# Claude Code, except the shared OpenSpec skills and commands
/.claude/*
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/opsx/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/openspec-*/

# Codex skills generated by OpenSpec, overriding global ignores of `.agents/`
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/.openspec-target
!/.agents/skills/openspec-*/

# PhpStorm
/.idea/

# Editor temporary files
*~
*.swp
*.swo
