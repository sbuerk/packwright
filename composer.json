{
    "name": "sbuerk/versflow",
    "description": "sb-releaser — a PHP CLI tool",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Stefan Bürk",
            "email": "stefan@buerk.tech"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "humbug/box": "^4.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "SBReleaser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SBReleaser\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "${PHP_BINARY} vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "${PHP_BINARY} vendor/bin/php-cs-fixer fix",
        "php:analyze": "${PHP_BINARY} vendor/bin/phpstan analyze",
        "php:analyze:generate-baseline": "${PHP_BINARY} vendor/bin/phpstan analyze --generate-baseline phpstan-baseline.neon",
        "test": "${PHP_BINARY} vendor/bin/phpunit",
        "test:unit": "${PHP_BINARY} vendor/bin/phpunit --testsuite unit",
        "test:functional": "${PHP_BINARY} vendor/bin/phpunit --testsuite functional",
        "dump-container": "${PHP_BINARY} bin/dump-container",
        "build": [
            "@dump-container",
            "${PHP_BINARY} vendor/bin/box compile --composer-bin=\"${COMPOSER_BINARY}\""
        ]
    },
    "scripts-descriptions": {
        "cs:check": "Check coding guidelines (dry-run, shows diff but does not modify files)",
        "cs:fix": "Fix coding guideline violations automatically",
        "php:analyze": "Run PHPStan static analysis",
        "php:analyze:generate-baseline": "Regenerate the PHPStan baseline from current findings",
        "test": "Run the complete test suite (unit + functional)",
        "test:unit": "Run unit tests only",
        "test:functional": "Run functional (integration) tests only",
        "dump-container": "Compile and dump the DI container to a PHP class for PHAR embedding",
        "build": "Compile the DI container then build the self-contained PHAR binary (build/sb-releaser)"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
